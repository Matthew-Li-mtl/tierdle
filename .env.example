# Copy this file to .env and fill in your own values. Never commit .env.

# From MongoDB Atlas: Connect > Drivers. The name after the last slash picks the database.
# Use /tierdle-test while testing, and /tierdle at launch.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tierdle-test

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The address of the website, used to build password reset links.
APP_URL=http://localhost:5173

# Gmail account and app password used to send reset emails.
# Leave both empty in development: reset links are printed in the API terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
